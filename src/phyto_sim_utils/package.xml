<?xml version="1.0"?>
<package format="2">
    <name>phyto_sim_utils</name>
    <version>0.1.0</version>
    <description>Shared launch utilities for PhytO-ARM simulators</description>
    <maintainer email="rgovostes@whoi.edu">Ryan Govostes</maintainer>
    <license>GPL-3.0</license>

    <buildtool_depend>catkin</buildtool_depend>

    <exec_depend>ds_sensor_msgs</exec_depend>
    <exec_depend>geometry_msgs</exec_depend>
    <exec_depend>gps_common</exec_depend>
    <exec_depend>python3-yaml</exec_depend>
    <exec_depend>rospy</exec_depend>
    <exec_depend>sensor_msgs</exec_depend>
    <exec_depend>std_msgs</exec_depend>

    <test_depend>ds_sensor_msgs</test_depend>
    <test_depend>python3-nose</test_depend>
    <test_depend>rostest</test_depend>
</package>
