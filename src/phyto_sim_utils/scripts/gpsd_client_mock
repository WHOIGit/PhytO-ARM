#!/usr/bin/env python3
"""Publish gpsd_client fixes directly when gpsd is unavailable.

When gpsd is available, gps_sim.py can feed it simulated NMEA sentences
so the production gpsd_client publishes the fixes.
"""
import rclpy

from gps_msgs.msg import GPSFix, GPSStatus
from phyto_sim_utils.gps import receive_fixes
from rclpy.executors import ExternalShutdownException
from sensor_msgs.msg import NavSatFix


def main():
    rclpy.init()
    node = rclpy.create_node('gps')

    def publish(fix):
        extended = GPSFix(header=fix.header, latitude=fix.latitude,
                          longitude=fix.longitude, altitude=fix.altitude,
                          position_covariance=fix.position_covariance,
                          position_covariance_type=fix.position_covariance_type)
        extended.status = GPSStatus(header=fix.header, status=fix.status.status,
                                    position_source=GPSStatus.SOURCE_GPS)
        extended.time = fix.header.stamp.sec + fix.header.stamp.nanosec / 1e9
        extended_pub.publish(extended)
        fix_pub.publish(fix)

    try:
        fix_pub = node.create_publisher(NavSatFix, '~/fix', 1)
        extended_pub = node.create_publisher(GPSFix, '~/extended_fix', 1)

        receive_fixes(node, publish)
        rclpy.spin(node)
    except (KeyboardInterrupt, ExternalShutdownException):
        pass
    finally:
        node.destroy_node()
        rclpy.try_shutdown()


if __name__ == '__main__':
    main()
