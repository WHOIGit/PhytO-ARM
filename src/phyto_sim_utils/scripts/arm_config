#!/usr/bin/env python3
"""Print one arm's settings as YAML for ros2 launch.

Both arms share a configuration file. Loading only the requested section
keeps the second launch from overwriting the first arm's ROS parameters.
"""
import sys

import yaml


if __name__ == '__main__':
    filename, arm = sys.argv[1:]
    with open(filename) as config:
        yaml.safe_dump(yaml.safe_load(config).get(arm, {}), sys.stdout)
