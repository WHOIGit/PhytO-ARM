#!/usr/bin/env python3
import os
import socket
import sys
import time


# Wait for a local TCP listener before running the command
if __name__ == '__main__':
    port, *command = sys.argv[1:]
    address = ('127.0.0.1', int(port))

    # ROS time may be paused during startup
    deadline = time.monotonic() + 30
    while time.monotonic() < deadline:
        try:
            with socket.create_connection(address, timeout=0.5):
                break
        except OSError:
            time.sleep(0.05)
    else:
        sys.exit(f'Timed out waiting for TCP port {port} on localhost')

    # Preserve the PID that roslaunch monitors
    os.execvp(command[0], command)
