<launch>
    <arg name="port" default="1502" />
    <arg name="refresh_rate" default="1" />

    <node pkg="jvl_motor" type="mac400_sim_node.py"
          name="mac400_sim" required="true">
        <param name="address" value="127.0.0.1" />
        <param name="port" value="$(arg port)" />
    </node>

    <node pkg="jvl_motor" type="jvl_motor_node.py" name="motor" required="true"
          launch-prefix="$(find phyto_sim_utils)/scripts/wait_for_socket $(arg port)">
        <param name="address" value="127.0.0.1" />
        <param name="port" value="$(arg port)" />
        <param name="refresh_rate" value="$(arg refresh_rate)" />
    </node>
</launch>
