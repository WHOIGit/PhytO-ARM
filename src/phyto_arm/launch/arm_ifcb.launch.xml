<launch>
    <arg name="params_file" />
    <arg name="ifcb_winch" default="false" />

    <node name="ifcb" pkg="ifcb" exec="ifcb">
        <param from="$(var params_file)" />
    </node>

    <node name="ifcb_logfilter" pkg="ifcb" exec="ifcb_logfilter">
        <param from="$(var params_file)" />
    </node>

    <!-- AML winch namespace. Important for separating similar nodes on different arms -->
    <group>
        <push-ros-namespace namespace="arm_ifcb" />
        <node name="arm" pkg="phyto_arm" exec="arm_ifcb.py">
            <param from="$(var params_file)" />
            <param name="winch_enabled" value="$(var ifcb_winch)" />
        </node>

        <!-- Conditionally run the motor, winch, and profiler nodes based on the winch_enabled argument -->
        <group if="$(var ifcb_winch)">
            <node name="ctd_comms" pkg="wr2_asio" exec="adapter_node">
                <param from="$(var params_file)" />
                <remap from="ros_connection/receive" to="ctd_comms/out" />
                <remap from="ros_connection/transmit" to="ctd_comms/in" />
            </node>

            <node name="ctd" pkg="aml_ctd" exec="aml_ctd_node.py">
                <param from="$(var params_file)" />
                <remap from="~/in" to="ctd_comms/in" />
            </node>

            <node name="profiler" pkg="phyto_arm" exec="profiler_node.py">
                <param from="$(var params_file)" />
            </node>

            <node name="motor" pkg="jvl_motor" exec="jvl_motor_node.py">
                <param from="$(var params_file)" />
            </node>

            <node name="winch" pkg="phyto_arm" exec="winch_node.py">
                <param from="$(var params_file)" />
            </node>
        </group>

        <node name="ifcb_runner" pkg="phyto_arm" exec="ifcb_runner.py">
            <param from="$(var params_file)" />
        </node>
    </group>
</launch>
