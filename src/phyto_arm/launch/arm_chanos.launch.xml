<launch>
    <arg name="params_file" />
    <arg name="chanos_winch" default="false" />

    <group>
        <push-ros-namespace namespace="arm_chanos" />
        <node name="ctd" pkg="rbr_maestro3_ctd" exec="rbr_maestro3_node.py">
            <param from="$(var params_file)" />
            <remap from="~/in" to="udp_stream" />
        </node>
        <node name="arm" pkg="phyto_arm" exec="arm_chanos.py">
            <param from="$(var params_file)" />
            <param name="winch_enabled" value="$(var chanos_winch)" />
        </node>
        <group if="$(var chanos_winch)">
            <node name="motor" pkg="jvl_motor" exec="jvl_motor_node.py">
                <param from="$(var params_file)" />
            </node>
            <node name="winch" pkg="phyto_arm" exec="winch_node.py">
                <param from="$(var params_file)" />
            </node>
        </group>
    </group>
</launch>
