<launch>
    <arg name="dli_port" default="18080" />
    <arg name="gpsd_port" default="29470" />
    <arg name="gui" default="true" />
    <arg name="mock_ifcb" default="false" />
    <arg name="motor_modbus_port" default="1502" />
    <arg name="paused" default="false" />

    <arg name="gear_ratio" value="60" />
    <arg name="spool_circumference" value="0.6604" />
    <arg name="wait_for_socket"
         value="$(find phyto_sim_utils)/scripts/wait_for_socket" />

    <include file="$(find gazebo_ros)/launch/empty_world.launch">
        <arg name="world_name"
             value="$(find phyto_gazebo)/worlds/winch.world" />
        <arg name="gui" value="false" />
        <arg name="paused" value="$(arg paused)" />
        <arg name="server_required" value="true" />
        <arg name="use_clock_frequency" value="true" />
        <arg name="pub_clock_frequency" value="100" />
    </include>

    <node if="$(arg gui)" pkg="phyto_gazebo" type="view_winch"
          name="gazebo_gui" required="true" />

    <include if="$(arg mock_ifcb)"
             file="$(find ifcb)/launch/ifcb_mock.launch" />

    <node pkg="dli_power_switch" type="dli_sim.py" name="dli_sim"
          required="true">
        <param name="port" value="$(arg dli_port)" />
    </node>
    <node pkg="dli_power_switch" type="dli_power_switch_node.py"
          name="digital_logger"
          launch-prefix="$(arg wait_for_socket) $(arg dli_port)">
        <param name="address" value="127.0.0.1:$(arg dli_port)" />
        <param name="password" type="str" value="" />
        <param name="username" type="str" value="" />
        <rosparam param="outlets">
            - {name: starlink, outlet: 8}
        </rosparam>
    </node>

    <node pkg="phyto_gazebo" type="gps_sim.py" name="gps_sim" required="true">
        <param name="port" value="$(arg gpsd_port)" />
    </node>
    <node pkg="gpsd_client" type="gpsd_client" name="gps"
          launch-prefix="$(arg wait_for_socket) $(arg gpsd_port)">
        <param name="check_fix_by_variance" value="false" />
        <param name="host" value="127.0.0.1" />
        <param name="port" value="$(arg gpsd_port)" />
        <param name="use_gps_time" value="false" />
        <remap from="/extended_fix" to="~extended_fix" />
        <remap from="/fix" to="~fix" />
    </node>

    <include file="$(find jvl_motor)/launch/sim_motor.launch">
        <arg name="motor_modbus_port" value="$(arg motor_modbus_port)" />
        <arg name="refresh_rate" value="20" />
    </include>

    <node pkg="phyto_sim_utils" type="ctd_sim.py" name="ctd_sim"
          required="true" />

    <node pkg="phyto_sim_utils" type="winch_drum.py" name="winch_drum"
          required="true">
        <param name="gear_ratio" value="$(arg gear_ratio)" />
        <param name="spool_circumference" value="$(arg spool_circumference)" />
    </node>

    <param name="ctd_topic" value="/ctd/depth" />
    <node pkg="phyto_arm" type="winch_node.py" name="winch" required="true">
        <param name="epsilon" value="0.025" />
        <param name="gear_ratio" value="$(arg gear_ratio)" />
        <param name="half_speed_dist" value="0.12" />
        <param name="max_speed" value="0.25" />
        <param name="safety_envelopes/position" value="0.20" />
        <param name="spool_circumference" value="$(arg spool_circumference)" />
    </node>
</launch>
