<launch>
    <include file="$(find ifcb)/launch/ifcb_mock.launch" />
    <group ns="arm_ifcb">
        <rosparam param="ifcb_maintenance">
            bead_interval: 0
            cartridge_debubble_interval: 0
            clean_interval: 0
            flush_after_sample: false
        </rosparam>
        <node pkg="phyto_arm" type="ifcb_runner.py" name="ifcb_runner" />
    </group>
    <test pkg="phyto_gazebo" type="ifcb_mock_test.py"
          test-name="ifcb_mock" time-limit="45" />
</launch>
