<?xml version="1.0"?>
<package format="3">
    <name>phyto_gazebo</name>
    <version>0.1.0</version>
    <description>Gazebo simulation of the winch and IFCB/CTD</description>
    <maintainer email="rgovostes@whoi.edu">Ryan Govostes</maintainer>
    <license>GPL-3.0</license>

    <buildtool_depend>ament_cmake</buildtool_depend>
    <build_depend>gazebo_dev</build_depend>
    <depend>geometry_msgs</depend>
    <depend>rclcpp</depend>
    <depend>std_msgs</depend>

    <exec_depend>aml_ctd</exec_depend>
    <exec_depend>dli_power_switch</exec_depend>
    <exec_depend>gazebo_plugins</exec_depend>
    <exec_depend>gazebo_ros</exec_depend>
    <exec_depend>ifcb</exec_depend>
    <exec_depend>jvl_motor</exec_depend>
    <exec_depend>launch_ros</exec_depend>
    <exec_depend>phyto_arm</exec_depend>
    <exec_depend>phyto_sim_utils</exec_depend>

    <test_depend>action_msgs</test_depend>
    <test_depend>ament_index_python</test_depend>
    <test_depend>aml_ctd_msgs</test_depend>
    <test_depend>dli_power_switch_msgs</test_depend>
    <test_depend>ds_sensor_msgs</test_depend>
    <test_depend>gazebo_msgs</test_depend>
    <test_depend>gps_msgs</test_depend>
    <test_depend>gpsd</test_depend>
    <test_depend>ifcb_msgs</test_depend>
    <test_depend>jvl_motor_msgs</test_depend>
    <test_depend>launch_testing</test_depend>
    <test_depend>launch_testing_ament_cmake</test_depend>
    <test_depend>phyto_arm_msgs</test_depend>
    <test_depend>python3-scipy</test_depend>
    <test_depend>rclpy</test_depend>
    <test_depend>wr2_msgs</test_depend>

    <export>
        <build_type>ament_cmake</build_type>
        <gazebo_ros plugin_path="${prefix}/../../lib" />
    </export>
</package>
