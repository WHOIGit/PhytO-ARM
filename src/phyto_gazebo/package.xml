<?xml version="1.0"?>
<package format="2">
    <name>phyto_gazebo</name>
    <version>0.1.0</version>
    <description>Gazebo simulation of the winch and IFCB/CTD</description>
    <maintainer email="rgovostes@whoi.edu">Ryan Govostes</maintainer>
    <license>GPL-3.0</license>

    <buildtool_depend>catkin</buildtool_depend>
    <build_depend>gazebo_dev</build_depend>
    <depend>geometry_msgs</depend>
    <depend>roscpp</depend>
    <depend>std_msgs</depend>

    <exec_depend>ds_sensor_msgs</exec_depend>
    <exec_depend>gazebo_ros</exec_depend>
    <exec_depend>gps_common</exec_depend>
    <exec_depend>gpsd</exec_depend>
    <exec_depend>gpsd_client</exec_depend>
    <exec_depend>hector_gazebo_plugins</exec_depend>
    <exec_depend>jvl_motor</exec_depend>
    <exec_depend>phyto_arm</exec_depend>
    <exec_depend>phyto_sim_utils</exec_depend>
    <exec_depend>rospy</exec_depend>
    <exec_depend>sensor_msgs</exec_depend>

    <test_depend>actionlib</test_depend>
    <test_depend>actionlib_msgs</test_depend>
    <test_depend>ds_sensor_msgs</test_depend>
    <test_depend>gazebo_msgs</test_depend>
    <test_depend>jvl_motor</test_depend>
    <test_depend>phyto_arm</test_depend>
    <test_depend>python3-nose</test_depend>
    <test_depend>rostest</test_depend>
    <test_depend>tf</test_depend>

    <export>
        <gazebo_ros plugin_path="${prefix}/../../lib" />
    </export>
</package>
