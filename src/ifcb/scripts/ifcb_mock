#!/usr/bin/env python3
"""Run the production IFCB ROS node with an in-memory host and routines."""
import base64
import json
import math

from threading import Event, RLock, Thread

from ifcb import node
from rclpy.clock import JumpThreshold
from rclpy.duration import Duration
from std_msgs.msg import Bool


MAINTENANCE = [{'Type': 'Sequence', 'Steps': [
    {'StepType': 'Wait', 'Arguments': [250]},
]}]

RUNSAMPLE = [{'Type': 'Sequence', 'Steps': [
    {'StepType': 'Wait', 'Arguments': [500]},
    {'StepType': 'ChangeSpeed', 'Arguments': ['{#SamplingSpeed}']},
    {'StepType': 'TriggerOnce'},
    {'StepType': 'Wait', 'Arguments': [1000]},
]}]

ROUTINES = {
    'beads': MAINTENANCE,
    'biocide': MAINTENANCE,
    'bleach': MAINTENANCE,
    'cartridgedebubble': MAINTENANCE,
    'debubble': MAINTENANCE,
    'flushsampletube': MAINTENANCE,
    'runsample': RUNSAMPLE,
}

# A single gray pixel for TriggerOnce image and ROI messages
PIXEL = base64.b64decode(
    'iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAAAAAA6fptVAAAACklEQVR4nGNo'
    'AAAAggCBd81ytgAAAABJRU5ErkJggg==')


# Validate the complete routine before acknowledging interactive:load
def parse_steps(groups):
    for group in groups:
        if group['Type'] != 'Sequence':
            raise ValueError('Expected a Sequence group')
        for step in group['Steps']:
            kind = step['StepType']
            args = step.get('Arguments', [])
            if kind == 'Wait':
                value = float(args[0]) / 1000
                if not math.isfinite(value) or value < 0:
                    raise ValueError('Expected a finite, nonnegative wait')
            elif kind == 'Report':
                value = args[0]
                if not isinstance(value, str):
                    raise ValueError('Expected report text')
            elif kind in ('ChangeSpeed', 'TriggerOnce'):
                value = None
            else:
                raise ValueError(f'Unsupported mock step: {kind}')
            yield kind, value


class RoutineRunner:
    def __init__(self, ros_node, steps, publishers, report):
        self.steps = iter(steps)
        self.pub = publishers
        self.report = report
        self.node = ros_node
        self.cancelled = Event()
        self.clock_changed = Event()

    def cancel(self):
        self.cancelled.set()
        self.clock_changed.set()

    # Sleep until either the wait expires or interactive:stop wakes the runner
    def wait(self, seconds):
        clock = self.node.get_clock()
        if not clock.ros_time_is_active:
            self.cancelled.wait(seconds)
            return

        threshold = JumpThreshold(min_forward=Duration(nanoseconds=1),
                                  min_backward=Duration(nanoseconds=-1))
        updates = clock.create_jump_callback(
            threshold, post_callback=lambda _: self.clock_changed.set())
        try:
            remaining = Duration(seconds=seconds).nanoseconds
            previous = clock.now().nanoseconds
            while remaining > 0 and not self.cancelled.is_set():
                self.clock_changed.wait()
                self.clock_changed.clear()
                now = clock.now().nanoseconds
                if previous and now > previous:
                    remaining -= now - previous
                previous = now
        finally:
            updates.unregister()

    # Return the seconds to wait, or None when the routine is complete
    def run_until_next_wait(self):
        for kind, value in self.steps:
            if kind == 'Wait' and value:
                return value
            if kind == 'Report':
                self.report('reportevent:' + value)
            elif kind == 'TriggerOnce':
                node.on_triggerimage(self.node, self.pub['img'], None, PIXEL)
                node.on_triggerrois(self.node, self.pub['roi'], self.pub['mkr'], None,
                                    [(0, 0, PIXEL)])


class MockHost:
    def __init__(self, ros_node, publishers):
        self.pub = publishers
        self.node = ros_node
        self.lock = RLock()  # Protect routine state shared with the worker
        self.loaded = None
        self.running = None

    def report(self, text):
        node.on_any_message(self.node, self.pub, (None, None, 0, text))

    def connect(self, wait_until_ready=False):
        # IFCBacquire sends its settings and state when a client connects.
        # The IFCB runner only needs the initial routine state from that update.
        with self.lock:
            self.pub['conn'].publish(Bool(data=True))
            if self.running is None:
                self.report('valuechanged:interactive:stopped')

    def stop(self):
        with self.lock:
            if self.running is not None:
                self.running.cancel()
                self.running = None

    def relay_message_to_host(self, command):
        with self.lock:
            if command.startswith('daq:setdatafolder:'):
                return
            if command == 'interactive:stop':
                self.finish()
                return
            if command.startswith('interactive:load:'):
                if self.running is not None:
                    raise ValueError('Routine already running')
                self.loaded = None
                groups = json.loads(command.split(':', 2)[2])
                self.loaded = list(parse_steps(groups))
            elif command == 'interactive:start':
                if self.running is not None:
                    raise ValueError('Routine already running')
                if self.loaded is None:
                    raise ValueError('No routine loaded')
                self.running = RoutineRunner(self.node, self.loaded, self.pub, self.report)
                self.report('valuechanged:interactive:started')
                self.start_worker()
            else:
                raise ValueError(f'Unsupported mock command: {command}')

    def finish(self):
        self.stop()
        self.report('valuechanged:interactive:stopped')
        node.on_interactive_stopped(self.node, self.pub['tx'])

    def start_worker(self):
        runner = self.running  # Hold a local reference before the thread starts

        def run():
            while True:
                with self.lock:
                    if runner.cancelled.is_set():
                        return
                    seconds = runner.run_until_next_wait()
                    if seconds is None:
                        self.finish()
                        return

                # Release the lock so interactive:stop can interrupt the wait
                runner.wait(seconds)

        Thread(target=run, daemon=True).start()


if __name__ == '__main__':
    node.main(MockHost, lambda name: ROUTINES[name])
