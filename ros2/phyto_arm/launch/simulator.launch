<launch>
    <arg name="config_file"
         default="$(find phyto_arm)/../../configs/example.yaml" />
    <arg name="gazebo" default="false" />
    <arg name="ctd" default="direct" />
    <arg name="gpsd" default="false" />
    <arg name="gui" default="true" />
    <arg name="ifcb_replay_dir" default="$(env HOME)/ifcb-replay" />
    <arg name="mock_ifcb" default="true" />

    <arg name="dli_port" default="18080" />
    <arg name="gpsd_port" default="29470" />
    <arg name="motor_modbus_port" default="1503" />

    <node name="lock_manager" pkg="phyto_arm" type="lock_manager.py">
        <param name="max_moving_winches" value="1" />
    </node>

    <group unless="$(arg gazebo)">
        <include file="$(find phyto_sim_utils)/launch/gps.launch">
            <arg name="gpsd" value="$(arg gpsd)" />
            <arg name="gpsd_port" value="$(arg gpsd_port)" />
        </include>
        <include file="$(find phyto_arm)/launch/sim_arm_ifcb.launch">
            <arg name="config_file" value="$(arg config_file)" />
            <arg name="ctd" value="$(arg ctd)" />
            <arg name="ifcb_winch" value="true" />
            <arg name="mock_ifcb" value="$(arg mock_ifcb)" />
            <arg name="motor_modbus_port" value="$(arg motor_modbus_port)" />
        </include>
    </group>

    <include if="$(arg gazebo)"
             file="$(find phyto_gazebo)/launch/winch.launch">
        <arg name="ctd" value="$(arg ctd)" />
        <arg name="dli_port" value="$(arg dli_port)" />
        <arg name="gpsd_port" value="$(arg gpsd_port)" />
        <arg name="gui" value="$(arg gui)" />
        <arg name="gpsd" value="$(arg gpsd)" />
        <arg name="mock_ifcb" value="$(arg mock_ifcb)" />
        <arg name="motor_modbus_port" value="$(arg motor_modbus_port)" />
    </include>

    <node unless="$(arg mock_ifcb)" name="ifcb_emulator" pkg="phyto_sim_utils"
          type="run_ifcb_emulator" args="'$(arg ifcb_replay_dir)'"
          output="screen" required="true" />
</launch>
