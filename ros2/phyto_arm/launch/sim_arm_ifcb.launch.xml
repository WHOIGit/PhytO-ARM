<launch>
    <arg name="ctd" default="direct" />
    <arg name="params_file" />
    <arg name="ifcb_winch" />
    <arg name="mock_ifcb" default="true" />
    <arg name="motor_modbus_port" default="1503" />

    <include if="$(var mock_ifcb)" file="$(find-pkg-share ifcb)/launch/ifcb_mock.launch.py">
        <arg name="params_file" value="$(var params_file)" />
    </include>

    <group>
        <push-ros-namespace namespace="arm_ifcb" />
        <include file="$(find-pkg-share phyto_arm)/launch/sim_cast.launch.xml">
            <arg name="arm" value="arm_ifcb" />
            <arg name="ctd" value="$(var ctd)" />
            <arg name="params_file" value="$(var params_file)" />
            <arg name="motor_modbus_port" value="$(var motor_modbus_port)" />
            <arg name="winch_enabled" value="$(var ifcb_winch)" />
        </include>

        <node name="arm" pkg="phyto_arm" exec="arm_ifcb.py">
            <param from="$(var params_file)" />
            <param name="winch_enabled" value="$(var ifcb_winch)" />
        </node>
        <node if="$(var mock_ifcb)" name="ifcb_runner" pkg="phyto_arm" exec="ifcb_runner.py">
            <param from="$(var params_file)" />
        </node>
        <node if="$(var ifcb_winch)" name="profiler" pkg="phyto_arm" exec="profiler_node.py">
            <param from="$(var params_file)" />
            <param name="arm_ifcb.ctd_topic" value="ctd/depth" />
            <param name="arm_ifcb.profiler.data_topic" value="ctd/ctd" />
            <param name="arm_ifcb.profiler.data_field" value="temperature" />
        </node>
    </group>
</launch>
