<launch>
    <arg name="ctd" default="rbr" />
    <arg name="params_file" />
    <arg name="chanos_winch" />
    <arg name="motor_modbus_port" default="1504" />

    <group>
        <push-ros-namespace namespace="arm_chanos" />
        <include file="$(find-pkg-share phyto_arm)/launch/sim_cast.launch.xml">
            <arg name="arm" value="arm_chanos" />
            <arg name="ctd" value="$(var ctd)" />
            <arg name="params_file" value="$(var params_file)" />
            <arg name="motor_modbus_port" value="$(var motor_modbus_port)" />
            <arg name="winch_enabled" value="$(var chanos_winch)" />
        </include>

        <node if="$(var chanos_winch)" name="arm" pkg="phyto_arm" exec="arm_chanos.py">
            <param from="$(var params_file)" />
            <param name="arm_chanos.winch_enabled" value="$(var chanos_winch)" />
        </node>
    </group>
</launch>
