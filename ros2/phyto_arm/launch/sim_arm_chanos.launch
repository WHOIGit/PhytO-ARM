<launch>
    <arg name="ctd" default="rbr" />
    <arg name="config_file" />
    <arg name="chanos_winch" />
    <arg name="motor_modbus_port" default="1504" />
    <arg name="config_reader"
         value="$(find phyto_sim_utils)/scripts/arm_config" />
    <param name="arm_chanos" type="yaml"
           command="'$(arg config_reader)' '$(arg config_file)' arm_chanos" />

    <group ns="arm_chanos">
        <include file="$(find phyto_arm)/launch/sim_cast.launch">
            <arg name="ctd" value="$(arg ctd)" />
            <arg name="motor_modbus_port" value="$(arg motor_modbus_port)" />
            <arg name="winch_enabled" value="$(arg chanos_winch)" />
        </include>

        <node if="$(arg chanos_winch)" name="arm"
              pkg="phyto_arm" type="arm_chanos.py" />
    </group>
</launch>
