<launch>
    <!-- This is the launch file for PhytO-ARM's core processes.
         See arm launch files for payload specific settings. -->

    <arg name="config_file" />
    <arg name="params_file" />
    <arg name="digital_logger" default="true" />
    <arg name="network_data_capture" default="false" />

    <include file="$(find-pkg-share rosbridge_server)/launch/rosbridge_websocket_launch.xml">
        <arg name="use_compression" value="true" />
    </include>

    <node name="lock_manager" pkg="phyto_arm" exec="lock_manager.py">
        <param from="$(var params_file)" />
    </node>

    <node if="$(var network_data_capture)" name="network_data_capture" pkg="phyto_arm" exec="network_data_capture.py">
        <param from="$(var params_file)" />
    </node>

    <!-- NOTE: triton_classifier dependency removed
    <group if="$(arg classifier)">
        <node name="classifier" pkg="triton_classifier" type="classifier_node.py" />

        <node name="image_converter" pkg="image_transport" type="republish"
              args="compressed in:=/ifcb/roi/image raw out:=/ifcb/roi/image" />
    </group>
    -->

    <include file="$(find-pkg-share phyto_arm)/launch/main_devices.launch.py">
        <arg name="config_file" value="$(var config_file)" />
    </include>

    <node name="web" pkg="phyto_arm" exec="web_node.py">
        <param from="$(var params_file)" />
    </node>

    <node if="$(var digital_logger)" name="digital_logger" pkg="dli_power_switch" exec="dli_power_switch_node.py">
        <param from="$(var params_file)" />
    </node>
</launch>
